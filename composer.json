{
  "name": "broadway/snapshotting",
  "description": "POC for snapshotting aggregates in broadway/broadway",
  "type": "library",
  "license": "MIT",
  "require": {
    "broadway/broadway": "^3.0",
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "broadway/coding-standard": "^1.2",
    "phpstan/phpstan": "^2.0",
    "phpspec/prophecy": "^1.15",
    "phpspec/prophecy-phpunit": "^2.2"
  },
  "authors": [
    {
      "name": "othillo",
      "email": "othillo@othillo.nl"
    }
  ],
  "autoload": {
    "psr-4": {
      "Broadway\\Snapshotting\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Broadway\\Snapshotting\\": "test/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0.x-dev"
    }
  },
  "abandoned": true
}
